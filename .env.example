# Copie este arquivo para .env e substitua os valores locais.
# Nunca versione o arquivo .env real.

# Banco de dados
POSTGRES_DB=libraryapi
POSTGRES_USER=libraryapi
POSTGRES_PASSWORD=libraryapi

DB_URL=jdbc:postgresql://postgres:5432/libraryapi
DB_USERNAME=libraryapi
DB_PASSWORD=libraryapi

# API
SERVER_PORT=8000
JWT_SECRET=troque-esta-chave-jwt-por-uma-chave-segura
JWT_ISSUER=library-api
JWT_ACCESS_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# Proteção contra tentativas repetidas de login
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CONNECT_TIMEOUT=2s
REDIS_TIMEOUT=2s
LOGIN_ATTEMPTS_ENABLED=true
LOGIN_MAX_ATTEMPTS=3
LOGIN_ATTEMPT_WINDOW=5m

# RabbitMQ (dentro do Docker o host é `rabbitmq`; fora use localhost)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=notifications
RABBITMQ_PASSWORD=notifications
NOTIFICATIONS_QUEUE=notifications.book-created
NOTIFICATIONS_CHUNK_SIZE=100

# E-mail (preencha quando a integração for criada)
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=seu-usuario
# MAIL_PASSWORD=sua-senha

# Admin seed
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=senha
