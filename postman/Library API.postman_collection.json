{
  "info": {
    "_postman_id": "c6a75176-9dc6-4953-9811-0a852880d8ba",
    "name": "Library API",
    "description": "Collection da Library API. Login e refresh salvam automaticamente o access token na variável {{accessToken}}. Os tokens são assinados com RS256; a chave pública pode ser inspecionada em /.well-known/jwks.json.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const response = pm.response.json();",
                  "pm.test('Returns the USER role', () => pm.expect(response.roles).to.eql(['USER']));",
                  "pm.test('Does not expose the password', () => pm.expect(response).not.to.have.property('password'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Maria Silva\",\n  \"email\": \"maria@example.com\",\n  \"password\": \"senha-segura\"\n}"
            },
            "url": "{{libraryApiUrl}}/api/auth/register",
            "description": "Cadastra um usuário com a role USER. Altere manualmente o e-mail para cada novo cadastro."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const response = pm.response.json();",
                  "pm.test('Returns a Bearer JWT', () => { pm.expect(response.tokenType).to.eql('Bearer'); pm.expect(response.accessToken).to.be.a('string').and.not.empty; pm.expect(response.accessToken.split('.')).to.have.length(3); });",
                  "pm.test('Returns the token lifetime in seconds', () => { pm.expect(response.expiresIn).to.be.a('number'); pm.expect(response.expiresIn).to.be.above(0); });",
                  "pm.collectionVariables.set('accessToken', response.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"maria@example.com\",\n  \"password\": \"senha-segura\"\n}"
            },
            "url": "{{libraryApiUrl}}/api/auth/login",
            "description": "Informe manualmente o e-mail e a senha cadastrados."
          }
        },
        {
          "name": "Refresh tokens",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const response = pm.response.json();",
                  "pm.test('Returns a new access JWT', () => pm.expect(response.accessToken.split('.')).to.have.length(3));",
                  "pm.collectionVariables.set('accessToken', response.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{libraryApiUrl}}/api/auth/refresh",
            "description": "O Postman preserva o cookie HttpOnly recebido no login. Execute Login antes desta requisição; não envie refresh token no body."
          }
        },
        {
          "name": "Get authenticated user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const response = pm.response.json();",
                  "pm.test('Returns the logged-in user', () => { pm.expect(response.id).to.be.a('string').and.not.empty; pm.expect(response.email).to.be.a('string').and.not.empty; });",
                  "pm.test('Does not expose the password', () => pm.expect(response).not.to.have.property('password'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{libraryApiUrl}}/api/auth/me",
            "description": "Retorna os dados do usuário associado ao access token, sem expor a senha."
          }
        },
        {
          "name": "Reject invalid login credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401 or 429', () => pm.expect(pm.response.code).to.be.oneOf([401, 429]));",
                  "const response = pm.response.json();",
                  "if (pm.response.code === 429) {",
                  "  pm.test('Returns remaining wait time', () => { pm.expect(response.retryAfterSeconds).to.be.above(0); pm.expect(pm.response.headers.get('Retry-After')).to.eql(String(response.retryAfterSeconds)); });",
                  "} else {",
                  "  pm.test('Returns a generic credentials message', () => pm.expect(response.message).to.eql('E-mail ou senha inválidos.'));",
                  "}",
                  "pm.test('Does not expose authentication details', () => { pm.expect(response).not.to.have.property('accessToken'); pm.expect(response).not.to.have.property('password'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"maria@example.com\",\n  \"password\": \"senha-incorreta\"\n}"
            },
            "url": "{{libraryApiUrl}}/api/auth/login",
            "description": "Valida o retorno 401 nas três primeiras tentativas. Na quarta tentativa dentro da janela, a API retorna 429, Retry-After e retryAfterSeconds."
          }
        },
        {
          "name": "Reject duplicate email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 409', () => pm.response.to.have.status(409));",
                  "pm.test('Returns conflict message', () => pm.expect(pm.response.json().message).to.eql('Já existe um usuário cadastrado com este e-mail.'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Outra Maria\",\n  \"email\": \"maria@example.com\",\n  \"password\": \"outra-senha-segura\"\n}"
            },
            "url": "{{libraryApiUrl}}/api/auth/register",
            "description": "Execute depois de Register user para validar o conflito de e-mail duplicado."
          }
        },
        {
          "name": "Reject invalid registration",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 422', () => pm.response.to.have.status(422));",
                  "pm.test('Returns validation errors', () => pm.expect(pm.response.json().errors).to.be.an('array').that.is.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"M\",\n  \"email\": \"email-invalido\",\n  \"password\": \"123\"\n}"
            },
            "url": "{{libraryApiUrl}}/api/auth/register"
          }
        }
      ]
    },
