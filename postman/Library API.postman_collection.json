{
  "info": {
    "_postman_id": "c6a75176-9dc6-4953-9811-0a852880d8ba",
    "name": "Library API",
    "description": "Collection para testar autenticação e a API de autores e livros. O cadastro gera um e-mail único, o login salva o JWT e as requisições de criação salvam automaticamente os IDs nas variáveis da collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000/api" },
    { "key": "userId", "value": "" },
    { "key": "registrationEmail", "value": "" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "authorId", "value": "" },
    { "key": "bookId", "value": "" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('registrationEmail', `user.${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const response = pm.response.json();",
                  "pm.test('Returns the USER role', () => pm.expect(response.roles).to.eql(['USER']));",
                  "pm.test('Does not expose the password', () => pm.expect(response).not.to.have.property('password'));",
                  "pm.collectionVariables.set('userId', response.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Maria Silva\",\n  \"email\": \"{{registrationEmail}}\",\n  \"password\": \"senha-segura\"\n}"
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Cadastra um usuário com a role USER. O e-mail é gerado no pre-request script para permitir novas execuções da collection."
          }
        },
        {
          "name": "Login",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "const response = pm.response.json();",
                "pm.test('Returns a Bearer JWT', () => { pm.expect(response.tokenType).to.eql('Bearer'); pm.expect(response.accessToken).to.be.a('string').and.not.empty; pm.expect(response.accessToken.split('.')).to.have.length(3); });",
                "pm.test('Returns a refresh token', () => pm.expect(response.refreshToken).to.be.a('string').and.not.empty);",
                "pm.test('Returns the token lifetime in seconds', () => { pm.expect(response.expiresIn).to.be.a('number'); pm.expect(response.expiresIn).to.be.above(0); });",
                "pm.collectionVariables.set('accessToken', response.accessToken);",
                "pm.collectionVariables.set('refreshToken', response.refreshToken);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{registrationEmail}}\",\n  \"password\": \"senha-segura\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Execute depois de Register user. Salva o JWT na variável accessToken."
          }
        },
        {
          "name": "Refresh tokens",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "const response = pm.response.json();",
                "const previousRefreshToken = pm.collectionVariables.get('refreshToken');",
                "pm.test('Rotates the refresh token', () => pm.expect(response.refreshToken).not.to.eql(previousRefreshToken));",
                "pm.test('Returns a new access JWT', () => pm.expect(response.accessToken.split('.')).to.have.length(3));",
                "pm.collectionVariables.set('accessToken', response.accessToken);",
                "pm.collectionVariables.set('refreshToken', response.refreshToken);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/refresh",
            "description": "Troca o refresh token atual por um novo par de tokens e atualiza as variáveis da collection."
          }
        },
        {
          "name": "Get authenticated user",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "const response = pm.response.json();",
                "pm.test('Returns the logged-in user', () => { pm.expect(response.id).to.eql(pm.collectionVariables.get('userId')); pm.expect(response.email).to.eql(pm.collectionVariables.get('registrationEmail')); });",
                "pm.test('Does not expose the password', () => pm.expect(response).not.to.have.property('password'));"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "url": "{{baseUrl}}/auth/me",
            "description": "Retorna os dados do usuário associado ao access token, sem expor a senha."
          }
        },
        {
          "name": "Reject invalid login credentials",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status 401', () => pm.response.to.have.status(401));",
                "const response = pm.response.json();",
                "pm.test('Returns a generic credentials message', () => pm.expect(response.message).to.eql('E-mail ou senha inválidos.'));",
                "pm.test('Does not expose authentication details', () => { pm.expect(response).not.to.have.property('accessToken'); pm.expect(response).not.to.have.property('password'); });"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{registrationEmail}}\",\n  \"password\": \"senha-incorreta\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Valida o retorno 401 e a mensagem genérica para uma senha incorreta."
          }
        },
        {
          "name": "Reject duplicate email",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status 409', () => pm.response.to.have.status(409));",
                "pm.test('Returns conflict message', () => pm.expect(pm.response.json().message).to.eql('Já existe um usuário cadastrado com este e-mail.'));"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Outra Maria\",\n  \"email\": \"{{registrationEmail}}\",\n  \"password\": \"outra-senha-segura\"\n}"
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Execute depois de Register user para validar o conflito de e-mail duplicado."
          }
        },
        {
          "name": "Reject invalid registration",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status 422', () => pm.response.to.have.status(422));",
                "pm.test('Returns validation errors', () => pm.expect(pm.response.json().errors).to.be.an('array').that.is.not.empty);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"M\",\n  \"email\": \"email-invalido\",\n  \"password\": \"123\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        }
      ]
    },
    {
      "name": "Authors",
      "item": [
        {
          "name": "Create author",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Machado de Assis\",\n  \"birthdate\": \"1839-06-21\",\n  \"nationality\": \"Brasileira\"\n}"
            },
            "url": "{{baseUrl}}/authors"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('authorId', pm.response.json().id);"
            ] }
          }]
        },
        {
          "name": "List authors",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/authors?page=1&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["authors"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "size", "value": "10" },
                { "key": "search", "value": "Machado", "disabled": true },
                { "key": "sortBy", "value": "NAME", "disabled": true },
                { "key": "direction", "value": "ASC", "disabled": true },
                { "key": "include", "value": "bookCount", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get author by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/authors/{{authorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["authors", "{{authorId}}"],
              "query": [
                { "key": "include", "value": "bookCount", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Update author",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Machado de Assis\",\n  \"birthdate\": \"1839-06-21\",\n  \"nationality\": \"Brasil\"\n}"
            },
            "url": "{{baseUrl}}/authors/{{authorId}}"
          }
        },
        {
          "name": "Delete author (run last)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/authors/{{authorId}}" }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "Create book",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Dom Casmurro\",\n  \"isbn\": \"978-85-359-0277-8\",\n  \"publishDate\": \"1899-01-01\",\n  \"gender\": \"FICCAO\",\n  \"price\": 49.90,\n  \"authorId\": \"{{authorId}}\"\n}"
            },
            "url": "{{baseUrl}}/books"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('bookId', pm.response.json().id);"
            ] }
          }]
        },
        {
          "name": "List books — filters",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books?page=1&size=10&authorId={{authorId}}&search=Dom&sortBy=TITLE&direction=ASC",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "size", "value": "10" },
                { "key": "authorId", "value": "{{authorId}}" },
                { "key": "search", "value": "Dom", "disabled": true },
                { "key": "title", "value": "Dom", "disabled": true },
                { "key": "isbn", "value": "978", "disabled": true },
                { "key": "gender", "value": "FICCAO", "disabled": true },
                { "key": "sortBy", "value": "TITLE", "disabled": true },
                { "key": "direction", "value": "ASC", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get book by ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/books/{{bookId}}" }
        },
        {
          "name": "Update book",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Dom Casmurro — edição revisada\",\n  \"isbn\": \"978-85-359-0277-8\",\n  \"publishDate\": \"1899-01-01\",\n  \"gender\": \"FICCAO\",\n  \"price\": 59.90,\n  \"authorId\": \"{{authorId}}\"\n}"
            },
            "url": "{{baseUrl}}/books/{{bookId}}"
          }
        },
        {
          "name": "Delete book (run before deleting author)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/books/{{bookId}}" }
        }
      ]
    }
  ]
}
