    {
      "name": "JWT",
      "item": [
        {
          "name": "Get public JWKS",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns public RSA keys', () => pm.expect(pm.response.json().keys).to.be.an('array').and.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{libraryApiUrl}}/.well-known/jwks.json",
            "description": "Endpoint público consumido pelos microserviços para validar os JWTs RS256. Não expõe a chave privada."
          }
        }
      ]
    }
  ],
  "variable": [
